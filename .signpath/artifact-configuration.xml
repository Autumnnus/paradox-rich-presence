<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration. Paste this into the project's Artifact Configurations
  in the SignPath web app.

  - GitHub artifacts are delivered as zip files, hence the zip-file root element.
  - SignPath Foundation requires product name and version metadata restrictions. The
    version is passed on every build by release.yml as the "version" parameter and must
    match the exe's ProductVersion (packaging/windows/make_version_info.py).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ParadoxRichPresence.exe" product-name="Paradox Rich Presence" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
