<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact yapilandirmasi. SignPath panelinde projenin Artifact Configurations
  bolumune bu icerik yapistirilir.

  - GitHub artifact'lari zip olarak iletildigi icin kok eleman zip-file'dir.
  - SignPath Foundation, urun adi ve surumu metadata kisitlariyla zorunlu tutar; surum her
    derlemede release.yml tarafindan "version" parametresiyle gonderilir ve exe'nin
    ProductVersion degeriyle (packaging/windows/make_version_info.py) eslesmelidir.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ParadoxRichPresence.exe" product-name="Paradox Rich Presence" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
